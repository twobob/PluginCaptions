{
  "manifest_version": 3,
  "name": "RuTranscribe - WebGPU Russian Captions",
  "version": "1.0.0",
  "description": "Real-time Russian speech recognition & English translation closed captions on web videos and live audio, powered by WebGPU and on-device Whisper.",
  "browser_specific_settings": {
    "gecko": {
      "id": "rutranscribe-webgpu@antigravity.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "page": "background.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RuTranscribe WebGPU",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "dashboard.html"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
