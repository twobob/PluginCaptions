{
  "name": "rutranscribe-webgpu",
  "version": "1.0.0",
  "description": "Firefox extension for real-time Russian-to-English closed captions powered by WebGPU and on-device Whisper.",
  "type": "module",
  "scripts": {
    "build": "vite build && node copy-assets.js",
    "dev": "vite",
    "generate-icons": "node generate-icons.js"
  },
  "keywords": [
    "firefox-extension",
    "webgpu",
    "whisper",
    "russian-translation",
    "closed-captions",
    "speech-to-text"
  ],
  "author": "Antigravity Pair Programmer",
  "license": "MIT",
  "devDependencies": {
    "@huggingface/transformers": "^3.3.3",
    "vite": "^6.2.0"
  }
}
